@page "/crf/{RouteKey}"
@rendermode InteractiveServer
@implements IDisposable
@inject FrameworkApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<div class="crf-page">
    @if (Loading)
    {
        <div class="crf-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        <div class="crumb">
            Create/View Framework / @GetWorkflowDisplay()
            @if (CurrentFramework is not null)
            {
                <span>
                    - @CurrentFramework.EntityName
                    @CurrentFramework.FrameworkDate.ToString("dd-MMM-yyyy")
                    - @CurrentFramework.Status
                </span>
            }
        </div>

        <div class="framework-toolbar">
            <div class="steps">
                @foreach (var step in Steps.OrderBy(x => x.DisplayOrder))
                {
                    <div class="step @(step.Id == ActiveStepId ? "active" : "")"
                         @onclick="() => ActiveStepId = step.Id">
                        <div class="step-circle">
                            <MudIcon Icon="@GetStepIcon(step.StepName)"
                                     Size="Size.Medium" />
                        </div>
                        <span>@step.StepName</span>
                    </div>
                }
            </div>

            <div class="framework-action-buttons">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="SaveDraft">
                    Save Draft
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="RunFramework">
                    Run Framework
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="SubmitFramework">
                    Submit
                </MudButton>
            </div>

            @if (CurrentFramework is not null && CurrentFramework.Id > 0)
            {
                <div class="framework-version-controls">
                    <MudSelect T="int"
                               Label="Workflow version"
                               Dense="true"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               MaxHeight="280"
                               PopoverClass="workflow-version-popover"
                               Value="@RequestedVersion"
                               ValueChanged="OnVersionSelectionChanged">
                        @foreach (var version in AvailableVersions.OrderByDescending(v => v.VersionNo))
                        {
                            <MudSelectItem T="int" Value="@version.VersionNo">
                                @version.VersionNo - @version.VersionName (@version.Status)
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Disabled="@(FrameworkLoading || RequestedVersion <= 0)"
                               OnClick="RetrieveSelectedVersion">
                        Retrieve
                    </MudButton>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(LookupError))
        {
            <MudAlert Severity="Severity.Error"
                      Dense="true"
                      Variant="Variant.Outlined"
                      Class="lookup-error">
                @LookupError
            </MudAlert>
        }

        <div class="crf-form-row">
            <div class="crf-field entity-search-field">
                <label>Entity Name <span>*</span></label>

                <div class="entity-lookup-wrap">
                    <MudTextField T="string"
                                  Value="@EntitySearchText"
                                  ValueChanged="OnEntitySearchChanged"
                                  Placeholder="Search entity"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Clearable="true"
                                  OnClearButtonClick="ClearEntitySelection"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  @onfocus="OpenEntityLookup" />

                    @if (EntityLookupOpen && EntitySearchResults.Count > 0)
                    {
                        <div class="entity-lookup-menu">
                            @foreach (var entity in EntitySearchResults)
                            {
                                <button type="button"
                                        class="entity-lookup-item"
                                        @onclick="() => SelectEntity(entity)">
                                    @entity.EntityName
                                </button>
                            }
                        </div>
                    }
                    else if (EntityLookupOpen &&
                             EntitySearchText.Trim().Length >= 2 &&
                             EntitySearchResults.Count == 0)
                    {
                        <div class="entity-lookup-menu entity-lookup-empty">
                            No entity found
                        </div>
                    }
                </div>
            </div>

            <div class="crf-field framework-select-field">
                <label>Create/View Framework <span>*</span></label>

                <MudSelect T="string"
                           Value="@SelectedFrameworkKey"
                           ValueChanged="OnFrameworkChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Disabled="@(SelectedEntity is null || FrameworkLoading)"
                           Placeholder="@(FrameworkLoading ? "Loading frameworks..." : "Select Framework")">

                    <MudSelectItem T="string" Value="@string.Empty">
                        Select Framework
                    </MudSelectItem>

                    @if (!HasDraft)
                    {
                        <MudSelectItem T="string" Value="@("NEW")">
                            Create New Framework
                        </MudSelectItem>
                    }

                    @foreach (var item in FrameworkOptions)
                    {
                        <MudSelectItem T="string" Value="@($"FW:{item.Id}")">
                            @item.DisplayName
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="consolidated-box">
                <MudCheckBox @bind-Value="ConsolidatedView"
                             Color="Color.Primary"
                             Disabled="@(CurrentFramework is null)">
                    Consolidated View
                </MudCheckBox>
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
            </div>
        </div>

        <div class="industry-card">
            <div class="industry-header">
                <div>Select the industry segments in which the entity operates</div>
                <div>Weight (%)</div>
                <div>Action</div>
                <div>Status</div>
                <div>Add/Delete industry segment</div>
            </div>

            @if (CurrentFramework?.IndustrySegments.Count > 0)
            {
                @foreach (var segment in CurrentFramework.IndustrySegments)
                {
                    <div class="industry-row">
                        <div class="industry-name">
                            @segment.IndustryName
                        </div>

                        <div class="industry-weight">
                            @segment.Weight.ToString("0.##")
                            <MudIcon Icon="@Icons.Material.Filled.Info"
                                     Size="Size.Small" />
                        </div>

                        <div>
                            <button type="button"
                                    class="score-action-button"
                                    disabled="@(!CanOpenScore(segment) || FrameworkLoading)"
                                    @onclick="() => OpenScoreDialog(segment)">
                                EDIT/VIEW SCORE
                            </button>
                        </div>

                        <div class="industry-status">
                            @segment.Status
                        </div>

                        <div class="industry-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Color="Color.Primary"
                                           Disabled="@(!CanSave)"
                                           OnClick="AddIndustrySegment" />

                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Default"
                                           Disabled="@(!CanSave)"
                                           OnClick="() => RemoveIndustrySegment(segment.Id)" />
                        </div>
                    </div>
                }
            }
            else if (IsNewFramework && SelectedEntity is not null)
            {
                <div class="industry-empty">
                    <div class="empty-industry-select">
                        <MudAutocomplete T="IndustrySegmentDto"
                                         SearchFunc="SearchIndustrySegments"
                                         ToStringFunc="@(x => x?.IndustryName ?? string.Empty)"
                                         Placeholder="Select industry segment"
                                         Variant="Variant.Text"
                                         Margin="Margin.Dense"
                                         ValueChanged="OnNewIndustrySelected" />
                    </div>
                    <div>-</div>
                    <div>-</div>
                    <div>-</div>
                    <div>
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Primary"
                                       Disabled="@(CurrentFramework?.IndustrySegments.Count == 0)"
                                       OnClick="AddIndustrySegment" />
                    </div>
                </div>
            }
            else
            {
                <div class="industry-empty-readonly">
                    Select an entity and framework to view industry segments.
                </div>
            }
        </div>

        @if (ScoreDialogOpen &&
             ScoreDialogSegment is not null &&
             CurrentFramework is not null)
        {
            <div class="score-dialog-backdrop" @onclick="CloseScoreDialog">
                <div class="score-dialog-window" @onclick:stopPropagation="true">
                    <BusinessScoreDialog EntityName="@CurrentFramework.EntityName"
                                         IndustryName="@ScoreDialogSegment.IndustryName"
                                         WorkflowCode="@WorkflowCode"
                                         VersionNo="@SelectedVersion"
                                         Parameters="@ScoreDialogParameters"
                                         InitialValues="@Values"
                                         InitialScores="@Scores"
                                         VersionWeights="@VersionWeights"
                                         OnSaved="HandleScoreDialogSaved"
                                         OnClosed="CloseScoreDialog" />
                </div>
            </div>
        }

        @if (Evaluation is not null)
        {
            <MudAlert Severity="@(Evaluation.Success ? Severity.Success : Severity.Error)"
                      Class="crf-result">
                @Evaluation.Message — Version @Evaluation.VersionNo —
                Weighted Average Score:
                <b>@Evaluation.WeightedAverageScore.ToString("0.00")</b>
            </MudAlert>
        }
    }
</div>

@code {
    [Parameter]
    public string RouteKey { get; set; } = "corporate";

    private WorkflowDto? Workflow;
    private FrameworkDto? CurrentFramework;
    private EntityDto? SelectedEntity;

    private List<EntityDto> EntitySearchResults = [];
    private List<FrameworkLookupDto> FrameworkOptions = [];
    private List<IndustrySegmentDto> IndustryOptions = [];
    private List<FrameworkStepDto> Steps = [];

    private string EntitySearchText = string.Empty;

    // Do not rely on a default code without resolving the current route.
    private string WorkflowCode = string.Empty;
    private string SelectedFrameworkKey = string.Empty;

    private int SelectedVersion;
    private int RequestedVersion;

    private List<VersionDto> AvailableVersions = [];

    private int ActiveStepId;

    private bool EntityLookupOpen;
    private bool ConsolidatedView;
    private bool Loading = true;
    private bool FrameworkLoading;

    private string? LookupError;
    private EvaluateResponse? Evaluation;

    private CancellationTokenSource? _entitySearchCts;
    private bool _industryOptionsLoaded;
    private string? _lastResolvedRouteKey;

    private Dictionary<string, decimal> VersionWeights =
        new(StringComparer.OrdinalIgnoreCase);

    private Dictionary<int, decimal> Values = new();
    private Dictionary<int, int> Scores = new();

    private bool ScoreDialogOpen;
    private BusinessParameterDetailsDto? ScoreDialogSegment;
    private List<ParameterDto> ScoreDialogParameters = [];

    // Cache keys contain workflow + version + industry.
    private readonly Dictionary<string, List<ParameterDto>> IndustryParameters =
        new(StringComparer.OrdinalIgnoreCase);

    private bool IsNewFramework => SelectedFrameworkKey == "NEW";

    private bool HasDraft => FrameworkOptions.Any(x =>
        string.Equals(x.Status, "Draft", StringComparison.OrdinalIgnoreCase));

    private bool HasPersistedFramework => CurrentFramework?.Id > 0;

    private bool CanSave =>
        SelectedEntity is not null &&
        CurrentFramework is not null &&
        !string.Equals(
            CurrentFramework.Status,
            "Submitted",
            StringComparison.OrdinalIgnoreCase) &&
        (IsNewFramework || HasPersistedFramework);

    private bool CanRun =>
        HasPersistedFramework &&
        CurrentFramework?.IndustrySegments.Count > 0;

    private bool CanSubmit =>
        HasPersistedFramework &&
        string.Equals(
            CurrentFramework?.Status,
            "Draft",
            StringComparison.OrdinalIgnoreCase);

    private string GetWorkflowDisplay() =>
        Workflow?.WorkflowName ?? "Corporate";

    private static string GetStepIcon(string stepName) =>
        stepName.Trim().ToLowerInvariant() switch
        {
            "business" => Icons.Material.Filled.Business,
            "general" => Icons.Material.Filled.Settings,
            "others" => Icons.Material.Filled.Category,
            "parent/group" => Icons.Material.Filled.AccountTree,
            "output" => Icons.Material.Filled.Assessment,
            "sensitivity" => Icons.Material.Filled.Tune,
            "summary" => Icons.Material.Filled.Summarize,
            "benchmarks" => Icons.Material.Filled.BarChart,
            _ => Icons.Material.Filled.Circle
        };

    // Runs on first load and whenever the route changes, e.g. /crf/CorporateBusiness
    // to /crf/asdaads. Component state is preserved during in-app navigation.
    protected override async Task OnParametersSetAsync()
    {
        var requestedRoute = RouteKey?.Trim() ?? string.Empty;
        if (string.Equals(_lastResolvedRouteKey, requestedRoute,
                StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(WorkflowCode))
            return;

        _lastResolvedRouteKey = requestedRoute;
        Loading = true;
        LookupError = null;

        try
        {
            if (!await ResolveWorkflowAsync(requestedRoute))
                return;

            var context = await Api.GetWorkflowContextAsync(WorkflowCode);
            if (context is null)
            {
                LookupError = $"Configuration for workflow '{WorkflowCode}' was not found.";
                return;
            }

            Workflow = context.Workflow;
            Steps = context.Steps.OrderBy(x => x.DisplayOrder).ToList();
            ActiveStepId = Steps.FirstOrDefault()?.Id ?? 0;

            // Do not keep versions/mappings from the previously selected workflow.
            AvailableVersions = [];
            SelectedVersion = 0;
            RequestedVersion = 0;
            IndustryParameters.Clear();
            VersionWeights.Clear();

            Console.WriteLine($"[CRF] Initialized. RouteKey={RouteKey}, WorkflowCode={WorkflowCode}");
        }
        catch (Exception ex)
        {
            LookupError = $"Workflow configuration lookup failed: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private static string? GetWorkflowCodeForIndustry(string? industryName)
    {
        if (string.IsNullOrWhiteSpace(industryName))
            return null;

        // Normalize common dash/spacing variations in industry names.
        var normalized = industryName.Trim()
            .Replace('–', '-')
            .Replace('—', '-');
        while (normalized.Contains("  ", StringComparison.Ordinal))
            normalized = normalized.Replace("  ", " ", StringComparison.Ordinal);
        normalized = System.Text.RegularExpressions.Regex.Replace(normalized, @"\s*-\s*", " - ");

        if (string.Equals(normalized, "Automobiles - Commercial Vehicles", StringComparison.OrdinalIgnoreCase))
            return "CorporateBusiness";

        if (string.Equals(normalized, "Automobiles - Passenger Vehicles", StringComparison.OrdinalIgnoreCase))
            return "asdaads";

        return null;
    }

    private async Task NavigateToWorkflowForIndustryAsync(string? industryName)
    {
        var workflowCode = GetWorkflowCodeForIndustry(industryName);
        if (string.IsNullOrWhiteSpace(workflowCode))
            return;

        if (string.Equals(RouteKey, workflowCode, StringComparison.OrdinalIgnoreCase))
            return;

        // Updates the URL without a full browser reload. OnParametersSetAsync resolves
        // the new workflow and its steps while preserving the current component state.
        Navigation.NavigateTo($"/crf/{Uri.EscapeDataString(workflowCode)}", replace: true);
        await Task.CompletedTask;
    }

    
    private async Task<bool> ResolveWorkflowAsync(string routeKey)
    {
        var workflows = await Api.GetWorkflowsAsync();

        if (workflows is null || workflows.Count == 0)
        {
            LookupError = "No workflows are configured.";
            return false;
        }

        var key = routeKey?.Trim() ?? string.Empty;

        // 1. Match the actual workflow code.
        var workflow = workflows.FirstOrDefault(x =>
            string.Equals(
                x.WorkflowCode?.Trim(),
                key,
                StringComparison.OrdinalIgnoreCase));

        // 2. Match the workflow name.
        workflow ??= workflows.FirstOrDefault(x =>
            string.Equals(
                x.WorkflowName?.Trim(),
                key,
                StringComparison.OrdinalIgnoreCase));

        // 3. Preserve the existing Corporate sidebar URL.
        if (workflow is null &&
            string.Equals(key, "corporate",
                StringComparison.OrdinalIgnoreCase))
        {
            workflow = workflows.FirstOrDefault(x =>
                string.Equals(
                    x.WorkflowCode?.Trim(),
                    "CorporateBusiness",
                    StringComparison.OrdinalIgnoreCase));
        }

        if (workflow is null ||
            string.IsNullOrWhiteSpace(workflow.WorkflowCode))
        {
            LookupError =
                $"Workflow '{key}' was not found. Check Workflow JSON management.";

            Workflow = null;
            WorkflowCode = string.Empty;
            return false;
        }

        Workflow = workflow;
        WorkflowCode = workflow.WorkflowCode.Trim();

        Console.WriteLine(
            $"[CRF] RouteKey={key}, WorkflowCode={WorkflowCode}");

        LookupError = null;
        return true;
    }

    // Re-resolve the workflow before making version or mapping requests.
    private async Task<bool> EnsureWorkflowCodeAsync()
    {
        if (!string.IsNullOrWhiteSpace(WorkflowCode))
            return true;

        return await ResolveWorkflowAsync(RouteKey);
    }

    private async Task LoadWorkflowVersionsAsync()
    {
        if (!await EnsureWorkflowCodeAsync())
        {
            throw new InvalidOperationException(
                LookupError ?? "Workflow code could not be resolved.");
        }

        Console.WriteLine(
            $"[CRF] GET versions: WorkflowCode='{WorkflowCode}'");

        AvailableVersions = (await Api.GetVersionsAsync(WorkflowCode))
            .OrderByDescending(x => x.VersionNo)
            .ToList();

        Console.WriteLine(
            $"[CRF] Loaded {AvailableVersions.Count} versions for {WorkflowCode}");
    }

    private async Task OpenEntityLookup(FocusEventArgs _)
    {
        EntityLookupOpen = true;

        if (EntitySearchText.Trim().Length < 2)
        {
            EntitySearchResults = [];
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnEntitySearchChanged(string? value)
    {
        EntitySearchText = value ?? string.Empty;
        EntityLookupOpen = true;
        LookupError = null;

        _entitySearchCts?.Cancel();
        _entitySearchCts?.Dispose();

        _entitySearchCts = new CancellationTokenSource();
        var token = _entitySearchCts.Token;

        if (EntitySearchText.Trim().Length < 2)
        {
            EntitySearchResults = [];
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            await Task.Delay(180, token);

            var result = await Api.SearchEntitiesAsync(
                EntitySearchText.Trim(),
                token);

            EntitySearchResults = result.Take(20).ToList();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            LookupError = $"Entity lookup failed: {ex.Message}";
            EntitySearchResults = [];
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectEntity(EntityDto entity)
    {
        EntityLookupOpen = false;
        EntitySearchText = entity.EntityName;

        await OnEntityChanged(entity);
    }

    private async Task ClearEntitySelection(MouseEventArgs _)
    {
        EntitySearchText = string.Empty;
        EntityLookupOpen = false;

        await OnEntityChanged(null);
    }

    private async Task OnEntityChanged(EntityDto? entity)
    {
        SelectedEntity = entity;
        CurrentFramework = null;
        SelectedFrameworkKey = string.Empty;
        FrameworkOptions = [];

        Evaluation = null;
        Values.Clear();
        Scores.Clear();
        VersionWeights.Clear();
        IndustryParameters.Clear();

        SelectedVersion = 0;
        RequestedVersion = 0;
        AvailableVersions = [];

        if (entity is null)
        {
            FrameworkLoading = false;
            return;
        }

        FrameworkLoading = true;
        LookupError = null;

        try
        {
            FrameworkOptions = (await Api.GetFrameworkOptionsAsync(entity.Id))
                .OrderByDescending(x => x.FrameworkDate)
                .ThenByDescending(x => x.Id)
                .ToList();
        }
        catch (Exception ex)
        {
            LookupError = $"Framework lookup failed: {ex.Message}";
            Snackbar.Add(LookupError, Severity.Error);
        }
        finally
        {
            FrameworkLoading = false;
            await InvokeAsync(StateHasChanged);
        }

    }

    private async Task OnFrameworkChanged(string key)
    {
        SelectedFrameworkKey = key;
        CurrentFramework = null;

        IndustryParameters.Clear();
        ScoreDialogParameters = [];

        Evaluation = null;
        Values.Clear();
        Scores.Clear();
        VersionWeights.Clear();

        SelectedVersion = 0;
        RequestedVersion = 0;

        ScoreDialogOpen = false;
        ScoreDialogSegment = null;
        LookupError = null;

        if (string.IsNullOrWhiteSpace(key))
            return;

        if (SelectedEntity is null)
        {
            LookupError = "Select an entity first.";
            return;
        }

        if (key == "NEW")
        {
            // Do not make a request such as /api/framework//versions.
            if (!await EnsureWorkflowCodeAsync())
            {
                Snackbar.Add(
                    LookupError ?? "Workflow code could not be resolved.",
                    Severity.Error);
                return;
            }

            if (HasDraft)
            {
                var draft = FrameworkOptions.First(x =>
                    string.Equals(
                        x.Status,
                        "Draft",
                        StringComparison.OrdinalIgnoreCase));

                SelectedFrameworkKey = $"FW:{draft.Id}";
                await LoadFramework(draft.Id);
                return;
            }

            FrameworkLoading = true;

            try
            {
                await EnsureIndustryOptionsAsync();
                await LoadWorkflowVersionsAsync();

                var latestPublished = AvailableVersions
                    .Where(x =>
                        x.IsPublished ||
                        string.Equals(
                            x.Status,
                            "Published",
                            StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(x => x.VersionNo)
                    .FirstOrDefault();

                if (latestPublished is null)
                {
                    SelectedVersion = 0;
                    RequestedVersion = 0;
                    SelectedFrameworkKey = string.Empty;

                    Snackbar.Add(
                        "No published workflow version exists. Publish a version first.",
                        Severity.Warning);

                    return;
                }

                SelectedVersion = latestPublished.VersionNo;
                RequestedVersion = SelectedVersion;

                CurrentFramework = new FrameworkDto
                {
                    EntityId = SelectedEntity.Id,
                    WorkflowCode = WorkflowCode,
                    EntityName = SelectedEntity.EntityName,
                    FrameworkName = $"{DateTime.Today:dd-MMM-yyyy} - Draft",
                    Status = "Draft",
                    WorkflowVersionNo = SelectedVersion,
                    FrameworkDate = DateTime.Today,
                    ConsolidatedView = false,
                    Steps = Steps.ToList(),
                    IndustrySegments = [],
                    Parameters = [],
                    ParameterValues = []
                };

                ConsolidatedView = false;

                Console.WriteLine(
                    $"[CRF] New framework: Workflow={WorkflowCode}, " +
                    $"Version=V{SelectedVersion}");
            }
            catch (Exception ex)
            {
                LookupError = $"Unable to load workflow versions: {ex.Message}";
                Snackbar.Add(LookupError, Severity.Error);
            }
            finally
            {
                FrameworkLoading = false;
                await InvokeAsync(StateHasChanged);
            }

            return;
        }

        if (key.StartsWith("FW:", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(key[3..], out var id))
        {
            await LoadFramework(id);
        }
    }

    private async Task LoadFramework(int id, int? versionNo = null)
    {
        FrameworkLoading = true;

        try
        {
            Values.Clear();
            Scores.Clear();
            VersionWeights.Clear();
            IndustryParameters.Clear();

            ScoreDialogParameters = [];
            Evaluation = null;
            ScoreDialogOpen = false;
            ScoreDialogSegment = null;

            CurrentFramework = await Api.GetFrameworkAsync(id, versionNo);

            if (CurrentFramework is null)
            {
                LookupError = "Selected framework could not be loaded.";
                return;
            }

            SelectedEntity = new EntityDto(
                CurrentFramework.EntityId,
                CurrentFramework.EntityName);

            WorkflowCode = string.IsNullOrWhiteSpace(CurrentFramework.WorkflowCode)
                ? WorkflowCode
                : CurrentFramework.WorkflowCode.Trim();

            if (!await EnsureWorkflowCodeAsync())
            {
                throw new InvalidOperationException(
                    LookupError ?? "Workflow code could not be resolved.");
            }

            SelectedVersion = CurrentFramework.WorkflowVersionNo;
            RequestedVersion = SelectedVersion;

            await LoadWorkflowVersionsAsync();

            ConsolidatedView = CurrentFramework.ConsolidatedView;

            // Existing frameworks also select the route associated with their industry.
            var industryWorkflowCode = GetWorkflowCodeForIndustry(
                CurrentFramework.IndustrySegments.FirstOrDefault()?.IndustryName);
            if (!string.IsNullOrWhiteSpace(industryWorkflowCode) &&
                !string.Equals(RouteKey, industryWorkflowCode, StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo($"/crf/{Uri.EscapeDataString(industryWorkflowCode)}", replace: true);
            }

            Steps = CurrentFramework.Steps
                .OrderBy(x => x.DisplayOrder)
                .ToList();

            ActiveStepId = Steps.FirstOrDefault()?.Id ?? 0;

            foreach (var parameterValue in CurrentFramework.ParameterValues)
            {
                if (parameterValue.Value.HasValue)
                {
                    Values[parameterValue.ParameterId] =
                        parameterValue.Value.Value;
                }

                Scores[parameterValue.ParameterId] =
                    parameterValue.Score;
            }

            if (!string.IsNullOrWhiteSpace(CurrentFramework.JsonStatus) &&
                CurrentFramework.JsonStatus.StartsWith(
                    "JSON failed",
                    StringComparison.OrdinalIgnoreCase))
            {
                Snackbar.Add(
                    CurrentFramework.JsonStatus +
                    ". Database values were loaded as fallback.",
                    Severity.Warning);
            }

            Console.WriteLine(
                $"[CRF] Framework loaded: Id={CurrentFramework.Id}, " +
                $"Workflow={WorkflowCode}, Version=V{SelectedVersion}");
        }
        catch (Exception ex)
        {
            LookupError = $"Framework could not be loaded: {ex.Message}";
            Snackbar.Add(LookupError, Severity.Error);
        }
        finally
        {
            FrameworkLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnVersionSelectionChanged(int versionNo)
    {
        RequestedVersion = versionNo;
    }

    private async Task RetrieveSelectedVersion()
    {
        if (CurrentFramework is null ||
            CurrentFramework.Id <= 0 ||
            RequestedVersion <= 0)
        {
            return;
        }

        var frameworkId = CurrentFramework.Id;
        var requested = RequestedVersion;

        await LoadFramework(frameworkId, requested);

        if (CurrentFramework is not null &&
            CurrentFramework.WorkflowVersionNo == requested)
        {
            Snackbar.Add(
                $"Retrieved workflow version V{SelectedVersion}. " +
                "Values are loaded for that version only.",
                Severity.Success);
        }
    }

    private async Task EnsureIndustryOptionsAsync()
    {
        if (_industryOptionsLoaded)
            return;

        IndustryOptions = (await Api.GetAllIndustriesAsync())
            .OrderBy(x => x.IndustryName)
            .ToList();

        _industryOptionsLoaded = true;
    }

    private async Task<IEnumerable<IndustrySegmentDto>> SearchIndustrySegments(
        string value,
        CancellationToken ct)
    {
        await EnsureIndustryOptionsAsync();

        return IndustryOptions.Where(x =>
            string.IsNullOrWhiteSpace(value) ||
            x.IndustryName.Contains(
                value,
                StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnNewIndustrySelected(IndustrySegmentDto? selected)
    {
        if (selected is null || CurrentFramework is null || !IsNewFramework)
            return;

        CurrentFramework.IndustryName = selected.IndustryName;
        CurrentFramework.IndustrySegments =
        [
            new BusinessParameterDetailsDto(0, selected.Id, selected.IndustryName, 100, "Saved")
        ];

        await NavigateToWorkflowForIndustryAsync(selected.IndustryName);
    }

    private bool CanOpenScore(BusinessParameterDetailsDto segment)
    {
        return CurrentFramework is not null &&
               !string.IsNullOrWhiteSpace(segment.IndustryName) &&
               SelectedVersion > 0;
    }

    private void AddIndustrySegment()
    {
        if (CurrentFramework is null ||
            !CanSave ||
            IndustryOptions.Count == 0)
        {
            return;
        }

        var available = IndustryOptions.FirstOrDefault(x =>
            CurrentFramework.IndustrySegments.All(
                s => s.IndustrySegmentId != x.Id));

        if (available is null)
            return;

        var count = CurrentFramework.IndustrySegments.Count + 1;
        var weight = Math.Round(100m / count, 2);

        CurrentFramework.IndustrySegments = CurrentFramework.IndustrySegments
            .Select(x => new BusinessParameterDetailsDto(
                x.Id,
                x.IndustrySegmentId,
                x.IndustryName,
                weight,
                x.Status))
            .Append(new BusinessParameterDetailsDto(
                0,
                available.Id,
                available.IndustryName,
                weight,
                "Saved"))
            .ToList();

        CurrentFramework.IndustryName =
            CurrentFramework.IndustrySegments.First().IndustryName;
    }

    private void RemoveIndustrySegment(int id)
    {
        if (CurrentFramework is null || !CanSave)
            return;

        var remaining = CurrentFramework.IndustrySegments
            .Where(x => x.Id != id)
            .ToList();

        if (remaining.Count == 0)
        {
            CurrentFramework.IndustryName = string.Empty;
            CurrentFramework.IndustrySegments = [];
            return;
        }

        var weight = Math.Round(100m / remaining.Count, 2);

        CurrentFramework.IndustryName = remaining.First().IndustryName;

        CurrentFramework.IndustrySegments = remaining
            .Select(x => new BusinessParameterDetailsDto(
                x.Id,
                x.IndustrySegmentId,
                x.IndustryName,
                weight,
                x.Status))
            .ToList();
    }

    private async Task LoadVersionWeightsAsync()
    {
        VersionWeights.Clear();

        if (string.IsNullOrWhiteSpace(WorkflowCode) || SelectedVersion <= 0)
            return;

        var version = await Api.GetVersionAsync(WorkflowCode, SelectedVersion);

        if (version is null || string.IsNullOrWhiteSpace(version.JsonContent))
            return;

        try
        {
            using var document =
                System.Text.Json.JsonDocument.Parse(version.JsonContent);

            var root = document.RootElement;

            // Support both a JSON array and a JSON object.
            if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                if (root.GetArrayLength() == 0)
                    return;

                root = root[0];
            }

            if (root.ValueKind != System.Text.Json.JsonValueKind.Object ||
                !root.TryGetProperty("Weights", out var weights) ||
                weights.ValueKind != System.Text.Json.JsonValueKind.Object)
            {
                return;
            }

            foreach (var property in weights.EnumerateObject())
            {
                if (property.Value.TryGetDecimal(out var weight))
                    VersionWeights[property.Name] = weight;
            }
        }
        catch (System.Text.Json.JsonException ex)
        {
            Console.WriteLine(
                $"[CRF] Invalid JSON weights for V{SelectedVersion}: {ex.Message}");
        }
    }

    private async Task<List<ParameterDto>> LoadParametersForIndustryAsync(
     int industryId)
    {
        if (industryId <= 0)
            return [];

        if (!await EnsureWorkflowCodeAsync())
        {
            throw new InvalidOperationException(
                LookupError ?? "Workflow code could not be resolved.");
        }

        if (SelectedVersion <= 0)
        {
            throw new InvalidOperationException(
                "No workflow version is selected.");
        }

        // Cache by workflow + version + industry.
        var cacheKey = $"{WorkflowCode}|{SelectedVersion}|{industryId}";

        if (IndustryParameters.TryGetValue(cacheKey, out var cached))
            return cached;

        Console.WriteLine(
            $"[CRF] Loading mappings: Workflow={WorkflowCode}, " +
            $"Version=V{SelectedVersion}, IndustryId={industryId}");

        // Fetch mappings for the exact workflow, version and industry.
        var mappings = await Api.GetIndustryParameterMappingsAsync(
            WorkflowCode,
            SelectedVersion,
            industryId);

        var parameters = new List<ParameterDto>();

        foreach (var mapping in mappings.Where(x => x.IsMapped))
        {
            if (mapping.IndustryParameterMappingId <= 0)
                continue;

            // The ID is the version-specific industry mapping ID.
            var parameter = await Api.GetParameterAsync(
                mapping.IndustryParameterMappingId);

            if (parameter is null)
            {
                Console.WriteLine(
                    $"[CRF] Parameter not found for mapping ID " +
                    $"{mapping.IndustryParameterMappingId}, " +
                    $"Workflow={WorkflowCode}, " +
                    $"Version=V{SelectedVersion}, IndustryId={industryId}");

                continue;
            }

            parameters.Add(parameter);
        }

        parameters = parameters
            .GroupBy(x => x.Id)
            .Select(g => g.First())
            .OrderBy(x => x.DisplayOrder)
            .ToList();

        IndustryParameters[cacheKey] = parameters;

        Console.WriteLine(
            $"[CRF] Loaded {parameters.Count} parameters for " +
            $"{WorkflowCode}, V{SelectedVersion}, IndustryId={industryId}");

        return parameters;
    }
    private async Task OpenScoreDialog(BusinessParameterDetailsDto segment)
    {
        if (!CanOpenScore(segment) || CurrentFramework is null)
            return;

        try
        {
            if (!await EnsureWorkflowCodeAsync())
            {
                Snackbar.Add(
                    LookupError ?? "Workflow code could not be resolved.",
                    Severity.Error);
                return;
            }

            // Keep the selected framework version; do not silently switch to latest.
            SelectedVersion = CurrentFramework.WorkflowVersionNo;
            RequestedVersion = SelectedVersion;

            ScoreDialogParameters =
                await LoadParametersForIndustryAsync(segment.IndustrySegmentId);

            if (ScoreDialogParameters.Count == 0)
            {
                var message =
                    $"No active parameters found for {segment.IndustryName}, " +
                    $"workflow {WorkflowCode}, version V{SelectedVersion}. " +
                    "Check the Industry Parameter Mapping page for this exact version.";

                Snackbar.Add(message, Severity.Warning);
                Console.WriteLine($"[CRF] {message}");
                return;
            }

            await LoadVersionWeightsAsync();

            ScoreDialogSegment = segment;
            ScoreDialogOpen = true;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            LookupError =
                $"Unable to load parameters for {segment.IndustryName}: {ex.Message}";

            Snackbar.Add(LookupError, Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleScoreDialogSaved(BusinessScoreDialogResult data)
    {
        foreach (var item in data.Parameters.Values)
        {
            if (item.Value.HasValue)
                Values[item.ParameterId] = item.Value.Value;

            Scores[item.ParameterId] = item.Score;
        }

        Evaluation = data.Evaluation;

        ScoreDialogOpen = false;
        ScoreDialogSegment = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseScoreDialog()
    {
        ScoreDialogOpen = false;
        ScoreDialogSegment = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveDraft()
    {
        if (CurrentFramework is null || SelectedEntity is null)
            return;

        if (!await EnsureWorkflowCodeAsync())
        {
            Snackbar.Add(
                LookupError ?? "Workflow code could not be resolved.",
                Severity.Error);
            return;
        }

        if (SelectedVersion <= 0)
        {
            Snackbar.Add(
                "Select a valid published workflow version before saving.",
                Severity.Warning);
            return;
        }

        if (CurrentFramework.IndustrySegments.Count == 0)
        {
            Snackbar.Add(
                "Select at least one industry segment.",
                Severity.Warning);
            return;
        }

        try
        {
            CurrentFramework.EntityId = SelectedEntity.Id;
            CurrentFramework.EntityName = SelectedEntity.EntityName;
            CurrentFramework.WorkflowCode = WorkflowCode;
            CurrentFramework.ConsolidatedView = ConsolidatedView;
            CurrentFramework.Status = "Draft";
            CurrentFramework.WorkflowVersionNo = SelectedVersion;

            var allIndustryParameters = new List<ParameterDto>();

            foreach (var segment in CurrentFramework.IndustrySegments)
            {
                allIndustryParameters.AddRange(
                    await LoadParametersForIndustryAsync(
                        segment.IndustrySegmentId));
            }

            CurrentFramework.Parameters = allIndustryParameters
                .GroupBy(p => p.Id)
                .Select(g => g.First())
                .OrderBy(p => p.DisplayOrder)
                .ToList();

            CurrentFramework.ParameterValues = CurrentFramework.Parameters
                .Select(p => new FrameworkParameterDto(
                    p.Id,
                    p.ParameterName,
                    p.Weight,
                    Values.TryGetValue(p.Id, out var value)
                        ? value
                        : null,
                    Scores.TryGetValue(p.Id, out var score)
                        ? score
                        : 0))
                .ToList();

            CurrentFramework = await Api.SaveFrameworkAsync(CurrentFramework);

            if (CurrentFramework is null)
            {
                Snackbar.Add(
                    "The API did not return the saved framework.",
                    Severity.Error);
                return;
            }

            SelectedFrameworkKey = $"FW:{CurrentFramework.Id}";

            FrameworkOptions = (await Api.GetFrameworkOptionsAsync(
                    SelectedEntity.Id))
                .OrderByDescending(x => x.FrameworkDate)
                .ThenByDescending(x => x.Id)
                .ToList();

            Snackbar.Add("Framework draft saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to save framework: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task RunFramework()
    {
        if (CurrentFramework is null)
            return;

        try
        {
            if (CurrentFramework.Id == 0)
            {
                await SaveDraft();

                if (CurrentFramework is null || CurrentFramework.Id == 0)
                    return;
            }

            if (!await EnsureWorkflowCodeAsync())
            {
                Snackbar.Add(
                    LookupError ?? "Workflow code could not be resolved.",
                    Severity.Error);
                return;
            }

            SelectedVersion = CurrentFramework.WorkflowVersionNo;

            if (SelectedVersion <= 0)
            {
                Snackbar.Add(
                    "No workflow version is selected.",
                    Severity.Warning);
                return;
            }

            await LoadVersionWeightsAsync();

            var runParameters = new List<ParameterDto>();

            foreach (var segment in CurrentFramework.IndustrySegments)
            {
                runParameters.AddRange(
                    await LoadParametersForIndustryAsync(
                        segment.IndustrySegmentId));
            }

            CurrentFramework.Parameters = runParameters
                .GroupBy(p => p.Id)
                .Select(g => g.First())
                .ToList();

            var evaluationParameters = CurrentFramework.Parameters
                .GroupBy(
                    p => p.ParameterCode,
                    StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .ToList();

            var values = evaluationParameters
                .Where(p => p.IsValueDriven)
                .ToDictionary(
                    p => p.ParameterCode,
                    p => Values.TryGetValue(p.Id, out var value)
                        ? (decimal?)value
                        : null,
                    StringComparer.OrdinalIgnoreCase);

            var manualScores = evaluationParameters
                .Where(p => !p.IsValueDriven)
                .ToDictionary(
                    p => p.ParameterCode,
                    p => Scores.TryGetValue(p.Id, out var score)
                        ? score
                        : 0,
                    StringComparer.OrdinalIgnoreCase);

            Evaluation = await Api.EvaluateAsync(
                new EvaluateRequest(
                    WorkflowCode,
                    SelectedVersion,
                    values,
                    manualScores));

            if (Evaluation is null)
            {
                Snackbar.Add(
                    "The evaluation API returned no response.",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Framework evaluation failed: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task SubmitFramework()
    {
        if (CurrentFramework is null)
            return;

        try
        {
            await SaveDraft();

            if (CurrentFramework is null || CurrentFramework.Id == 0)
                return;

            CurrentFramework.FrameworkName =
                RemoveDraftSuffix(CurrentFramework.FrameworkName);

            CurrentFramework.Status = "Submitted";

            CurrentFramework = await Api.SaveFrameworkAsync(CurrentFramework);

            if (CurrentFramework is null)
            {
                Snackbar.Add(
                    "The API did not return the submitted framework.",
                    Severity.Error);
                return;
            }

            if (SelectedEntity is not null)
            {
                FrameworkOptions = (await Api.GetFrameworkOptionsAsync(
                        SelectedEntity.Id))
                    .OrderByDescending(x => x.FrameworkDate)
                    .ThenByDescending(x => x.Id)
                    .ToList();
            }

            SelectedFrameworkKey = $"FW:{CurrentFramework.Id}";

            Snackbar.Add("Framework submitted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Framework submission failed: {ex.Message}",
                Severity.Error);
        }
    }

    private static string RemoveDraftSuffix(string? frameworkName)
    {
        const string suffix = " - Draft";

        var name = frameworkName?.Trim() ?? string.Empty;

        return name.EndsWith(
            suffix,
            StringComparison.OrdinalIgnoreCase)
            ? name[..^suffix.Length].TrimEnd()
            : name;
    }

    public void Dispose()
    {
        _entitySearchCts?.Cancel();
        _entitySearchCts?.Dispose();
    }
